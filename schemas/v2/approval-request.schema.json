{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eust-w/agentic-embedded-lab/internal/protocol/approval-request",
  "properties": {
    "api_version": {
      "type": "string"
    },
    "id": {
      "type": "string"
    },
    "thread_id": {
      "type": "string"
    },
    "turn_id": {
      "type": "string"
    },
    "tool": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "risk": {
      "type": "string"
    },
    "scope": {
      "type": "string"
    },
    "resource": {
      "type": "string"
    },
    "metadata": {
      "type": "object"
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "api_version",
    "id",
    "thread_id",
    "turn_id",
    "tool",
    "reason",
    "risk",
    "scope",
    "resource",
    "created_at"
