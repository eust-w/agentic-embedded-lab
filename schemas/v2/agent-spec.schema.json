{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/eust-w/agentic-embedded-lab/internal/protocol/agent-spec",
  "properties": {
    "name": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "model": {
      "type": "string"
    },
    "reasoning_effort": {
      "type": "string"
    },
    "permission": {
      "type": "string"
    },
    "tools": {
      "items": {
        "type": "string"
      },
      "type": "array"
    },
    "max_concurrency": {
      "type": "integer"
    }
  },
  "additionalProperties": false,
  "type": "object",
  "required": [
    "name",
    "role",
    "model",
    "reasoning_effort",
    "permission",
    "tools",
    "max_concurrency"
  ]
}
