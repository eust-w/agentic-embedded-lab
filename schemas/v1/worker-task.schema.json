{
  "$defs": {
    "TaskStatus": {
      "enum": [
        "queued",
        "leased",
        "running",
        "succeeded",
        "failed",
        "cancelled",
        "expired"
      ],
      "title": "TaskStatus",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "ael.dev/v1",
      "default": "ael.dev/v1",
      "title": "Api Version",
      "type": "string"
    },
    "attempts": {
      "default": 0,
      "minimum": 0,
      "title": "Attempts",
      "type": "integer"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "idempotency_key": {
      "title": "Idempotency Key",
      "type": "string"
    },
    "kind": {
      "const": "WorkerTask",
      "default": "WorkerTask",
      "title": "Kind",
      "type": "string"
    },
    "lease_expires_at": {
      "anyOf": [
        {
          "format": "date-time",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lease Expires At"
    },
    "lease_owner": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lease Owner"
    },
    "lease_token": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Lease Token"
    },
    "payload": {
      "additionalProperties": true,
      "title": "Payload",
      "type": "object"
    },
    "required_capabilities": {
      "items": {
        "type": "string"
      },
      "title": "Required Capabilities",
      "type": "array"
    },
    "result": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Result"
    },
    "status": {
      "$ref": "#/$defs/TaskStatus",
      "default": "queued"
    },
    "task_id": {
      "title": "Task Id",
      "type": "string"
    },
    "task_type": {
      "enum": [
        "experiment",
        "model_validation",
        "calibration",
        "hardware_validation"
      ],
      "title": "Task Type",
      "type": "string"
    }
  },
  "required": [
    "task_id",
    "task_type",
    "payload",
    "idempotency_key"
  ],
  "title": "WorkerTask",
  "type": "object"
}
