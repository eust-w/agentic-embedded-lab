{
  "$defs": {
    "BackendName": {
      "enum": [
        "zephyr_build",
        "native",
        "renode",
        "ngspice",
        "openmodelica",
        "omsimulator",
        "ns3",
        "openems",
        "hardware",
        "synthetic"
      ],
      "title": "BackendName",
      "type": "string"
    },
    "ModelState": {
      "enum": [
        "draft",
        "generated",
        "static_validated",
        "conformance_validated",
        "hardware_validated",
        "production_approved",
        "deprecated"
      ],
      "title": "ModelState",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "api_version": {
      "const": "ael.dev/v1",
      "default": "ael.dev/v1",
      "title": "Api Version",
      "type": "string"
    },
    "artifact_paths": {
      "items": {
        "type": "string"
      },
      "title": "Artifact Paths",
      "type": "array"
    },
    "backend": {
      "$ref": "#/$defs/BackendName"
    },
    "created_at": {
      "format": "date-time",
      "title": "Created At",
      "type": "string"
    },
    "generated_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generated By"
    },
    "generation_receipt_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Generation Receipt Path"
    },
    "grounding_manifest_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Grounding Manifest Path"
    },
    "id": {
      "title": "Id",
      "type": "string"
    },
    "ir_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Ir Path"
    },
    "kind": {
      "const": "ModelPackage",
      "default": "ModelPackage",
      "title": "Kind",
      "type": "string"
    },
    "name": {
      "title": "Name",
      "type": "string"
    },
    "signature": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Signature"
    },
    "source_hashes": {
      "additionalProperties": {
        "type": "string"
      },
      "title": "Source Hashes",
      "type": "object"
    },
    "source_paths": {
      "items": {
        "type": "string"
      },
      "title": "Source Paths",
      "type": "array"
    },
    "state": {
      "$ref": "#/$defs/ModelState",
      "default": "draft"
    },
    "test_paths": {
      "items": {
        "type": "string"
      },
      "title": "Test Paths",
      "type": "array"
    },
    "validation_evidence": {
      "items": {
        "type": "string"
      },
      "title": "Validation Evidence",
      "type": "array"
    },
    "version": {
      "title": "Version",
      "type": "string"
    }
  },
  "required": [
    "id",
    "name",
    "version",
    "backend"
  ],
  "title": "ModelPackage",
  "type": "object"
}
