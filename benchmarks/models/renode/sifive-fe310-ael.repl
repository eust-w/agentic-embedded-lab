# SPDX-License-Identifier: MIT
# Derived from Renode v1.16.1 platforms/cpus/sifive-fe310.repl.
# The upstream network-fetched SVD annotation is intentionally omitted so the
# platform remains executable in AEL's network-disabled backend sandbox. SVD
# annotations improve register names in logs; they do not implement behavior.

dtim: Memory.MappedMemory @ sysbus 0x80000000
    size: 0x4000

uart0: UART.SiFive_UART @ sysbus 0x10013000
    IRQ -> plic@3

uart1: UART.SiFive_UART @ sysbus 0x10023000
    IRQ -> plic@4

cpu: CPU.RiscV32 @ sysbus
    cpuType: "rv32imac_zicsr_zifencei"
    privilegedArchitecture: PrivilegedArchitecture.Priv1_10
    timeProvider: clint

plic: IRQControllers.PlatformLevelInterruptController @ sysbus 0x0C000000
    0 -> cpu@11
    numberOfSources: 52
    numberOfContexts: 1

clint: IRQControllers.CoreLevelInterruptor @ sysbus 0x02000000
    [0,1] -> cpu@[3,7]
    frequency: 62000000

code: Memory.MappedMemory @ sysbus 0x20000000
    // AEL maps only the executable reference image window. This is a
    // functional firmware model, not an implementation of QSPI flash.
    size: 0x00040000
