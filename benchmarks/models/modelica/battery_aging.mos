model AelBatteryAging
  parameter Real initialCapacityAh = {{capacity_Ah}};
  parameter Real fadePerCycle = {{fade_per_cycle}};
  parameter Real cycles = {{cycles}};
  parameter Real loadCurrent = {{load_current_A}};
  parameter Real ambientTemperature = {{ambient_temperature_C}};
  parameter Real temperatureCoefficient = {{temperature_coefficient_per_C}};
  parameter Real nominalVoltage = {{nominal_voltage_V}};
  parameter Real baseResistance = {{base_resistance_ohm}};
  parameter Real resistanceGrowthPerCycle = {{resistance_growth_per_cycle}};
  Real remainingCapacityAh;
  Real runtimeHours;
  Real internalResistance;
  Real loadedVoltage;
equation
  remainingCapacityAh = initialCapacityAh * max(0.05, 1.0 - fadePerCycle * cycles) * max(0.7, 1.0 - temperatureCoefficient * abs(ambientTemperature - 25.0));
  runtimeHours = remainingCapacityAh / loadCurrent;
  internalResistance = baseResistance * (1.0 + resistanceGrowthPerCycle * cycles);
  loadedVoltage = nominalVoltage - loadCurrent * internalResistance;
end AelBatteryAging;
result := simulate(AelBatteryAging, stopTime=1.0, numberOfIntervals=1, outputFormat="mat", fileNamePrefix="ael_battery");
capacity := val(remainingCapacityAh, 1.0, "ael_battery_res.mat");
runtime := val(runtimeHours, 1.0, "ael_battery_res.mat");
resistance := val(internalResistance, 1.0, "ael_battery_res.mat");
voltage := val(loadedVoltage, 1.0, "ael_battery_res.mat");
retention := capacity / {{capacity_Ah}};
failure := if runtime < {{minimum_runtime_h}} or voltage < {{cutoff_voltage_V}} or retention < {{minimum_capacity_retention}} then 1.0 else 0.0;
print("AEL_METRIC remaining_capacity_Ah=" + String(capacity) + "\n");
print("AEL_METRIC capacity_retention=" + String(retention) + "\n");
print("AEL_METRIC runtime_hours=" + String(runtime) + "\n");
print("AEL_METRIC internal_resistance_ohm=" + String(resistance) + "\n");
print("AEL_METRIC loaded_voltage_V=" + String(voltage) + "\n");
print("AEL_METRIC failure=" + String(failure) + "\n");
print("AEL_EVENT modelica.battery_aging {\"effects\":[\"cycle_fade\",\"temperature\",\"resistance_growth\"],\"calibrated\":false}\n");
