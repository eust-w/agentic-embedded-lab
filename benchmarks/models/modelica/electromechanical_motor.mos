model AelMotor
  parameter Real inertia = {{inertia}};
  parameter Real damping = {{damping}};
  parameter Real torque = {{torque}};
  parameter Real loadTorque = {{load_torque}};
  parameter Real thermalResistance = {{thermal_resistance_K_per_W}};
  parameter Real thermalCapacity = {{thermal_capacity_J_per_K}};
  parameter Real ambientTemperature = {{ambient_temperature_C}};
  Real speed(start=0, fixed=true);
  Real temperature(start=ambientTemperature, fixed=true);
equation
  inertia * der(speed) = torque - loadTorque - damping * speed;
  thermalCapacity * der(temperature) = damping * speed * speed - (temperature - ambientTemperature) / thermalResistance;
end AelMotor;
result := simulate(AelMotor, stopTime=2.0, numberOfIntervals=800, tolerance=1e-8, outputFormat="mat", fileNamePrefix="ael_motor");
speed100ms := val(speed, 0.1, "ael_motor_res.mat");
speed1s := val(speed, 1.0, "ael_motor_res.mat");
speed := val(speed, 2.0, "ael_motor_res.mat");
temperature := val(temperature, 2.0, "ael_motor_res.mat");
steadySpeed := ({{torque}} - {{load_torque}}) / {{damping}};
settlingError := abs(speed - steadySpeed) / max(1e-9, abs(steadySpeed));
failure := if speed > {{speed_limit}} or temperature > {{temperature_limit_C}} or settlingError > {{maximum_settling_error}} then 1.0 else 0.0;
print("AEL_METRIC speed_100ms=" + String(speed100ms) + "\n");
print("AEL_METRIC speed_1s=" + String(speed1s) + "\n");
print("AEL_METRIC speed=" + String(speed) + "\n");
print("AEL_METRIC steady_speed=" + String(steadySpeed) + "\n");
print("AEL_METRIC settling_error=" + String(settlingError) + "\n");
print("AEL_METRIC temperature_C=" + String(temperature) + "\n");
print("AEL_METRIC failure=" + String(failure) + "\n");
print("AEL_EVENT modelica.electromechanical_motor {\"states\":[\"speed\",\"temperature\"],\"calibrated\":false}\n");
