{
  "manifest_version": 3,
  "name": "Aether Desktop 标签页桥接",
  "description": "仅在用户点击扩展后，将当前 Chrome 标签页的结构化快照发送给本机 Aether Desktop。",
  "version": "1.0.0",
  "key": "",
  "permissions": ["activeTab", "nativeMessaging", "scripting"],
  "background": { "service_worker": "service-worker.js", "type": "module" },
  "action": { "default_title": "发送当前标签页到 Aether", "default_popup": "popup.html" }
}
